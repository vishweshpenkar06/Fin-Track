# Database - Required for production
DATABASE_URL=postgresql://user:password@your-neon-db.com/fintrack

# Better Auth - Session Management - REQUIRED
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# Optional: Override the Better Auth base URL (auto-detected from environment if not set)
# BETTER_AUTH_URL=https://your-domain.com

# Resend - For weekly summary emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Cron Secret - For protecting cron endpoints
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here-min-32-chars

# Auto-detected by Vercel (for production deployments)
# VERCEL_URL=your-deployment.vercel.app
# VERCEL_PROJECT_PRODUCTION_URL=your-production-domain.com
# V0_RUNTIME_URL=https://v0-runtime.vercel.sh
